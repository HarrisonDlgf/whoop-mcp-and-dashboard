# Copy this file to .env and fill in real values. .env is gitignored.

# ---- Database (Neon Postgres) ----
# Use the DIRECT (unpooled) connection string from your Neon dashboard.
# For a single-user app the direct connection is simplest and sidesteps
# pooler-vs-migration issues.
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=require"

# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APP_SECRET=""

# ---- WHOOP OAuth ----
WHOOP_CLIENT_ID=""
WHOOP_CLIENT_SECRET=""
WHOOP_REDIRECT_URI="http://localhost:3000/api/whoop/callback"

# Secret path segment for the MCP HTTP endpoint (generate: openssl rand -hex 24)
MCP_HTTP_SECRET=

# Vercel Cron auth (generate: openssl rand -hex 24)
CRON_SECRET=
