# Copy this file to .env and fill in real values. .env is gitignored.

# ---- Database (Neon Postgres) ----
# Use the DIRECT (unpooled) connection string from your Neon dashboard.
# For a single-user app the direct connection is simplest and sidesteps
# pooler-vs-migration issues.
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=require"

# ---- App gate (v1 single-user secret) ----
# Required. A random string (>=16 chars) that gates protected routes.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APP_SECRET=""

# ---- WHOOP OAuth ----
WHOOP_CLIENT_ID=""
WHOOP_CLIENT_SECRET=""
WHOOP_REDIRECT_URI="http://localhost:3000/api/whoop/callback"
