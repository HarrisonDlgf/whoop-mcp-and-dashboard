# Copy this file to .env and fill in real values. .env is gitignored.

# ---- Database (Neon Postgres) ----
# Use the DIRECT (unpooled) connection string from your Neon dashboard.
# For a single-user app the direct connection is simplest and sidesteps
# pooler-vs-migration issues.
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=require"

# ---- App gate (v1 single-user secret) ----
# A random string that gates the app. Wired in M1.
APP_SECRET=""

# ---- WHOOP OAuth (filled in M1) ----
# WHOOP_CLIENT_ID=""
# WHOOP_CLIENT_SECRET=""
# WHOOP_REDIRECT_URI="http://localhost:3000/api/whoop/callback"
